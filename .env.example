# -----------------------------------------------------------------------------
# KELİME PATLAT - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Bu dosyayı canlıya (Render, Heroku, VPS vb.) taşırken ortam değişkeni (env) olarak girin.
# -----------------------------------------------------------------------------

# --- BACKEND SERVER CONFIGURATION ---
# Sunucunun çalışacağı port (Hizmet sağlayıcılar otomatik atar, yoksa 3000 olur)
PORT=3000

# En az 32 karakterlik rastgele production JWT anahtarı
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Virgülle ayrılmış izinli frontend originleri
CORS_ORIGINS=https://kelime-patlat.app

# Canlı MongoDB kümesi bağlantı adresi (Örn: MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kelime_patlat?retryWrites=true&w=majority

# Web istemcisinin (frontend) canlı adresi (OAuth yönlendirmeleri için)
EXPO_WEB_PREVIEW_URL=https://kelime-patlat.app


# --- FRONTEND CLIENT CONFIGURATION (React Native / Expo) ---
# Expo uygulamasının canlı backend sunucusuna bağlanması için URL adresi
EXPO_PUBLIC_API_BASE_URL=https://api.kelime-patlat.app

# --- GOOGLE ADMOB ENTEGRASYONU (ANDROID & IOS) ---
# AdMob Konsolundan (admob.google.com) alınan Uygulama Kimlikleri (App IDs)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# Banner Reklam Birimi Kimlikleri (Ad Unit IDs)
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=ca-app-pub-3940256099942544/2934735716

# Geçiş (Interstitial) Reklam Birimi Kimlikleri
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-3940256099942544/4411468910

# Ödüllü Video (Rewarded) Reklam Birimi Kimlikleri
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=ca-app-pub-3940256099942544/1712485313

# Test Modu: Geliştirme aşamasında 'true' bırakın (Google banlamasını önler).
# Canlı mağaza sürümüne (Google Play / App Store) çıkarken 'false' yapın.
EXPO_PUBLIC_ADMOB_TEST_MODE=true

