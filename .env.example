# -----------------------------------------------------------------------------
# KELİME PATLAT - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Bu dosyayı canlıya (Render, Heroku, VPS vb.) taşırken ortam değişkeni (env) olarak girin.
# -----------------------------------------------------------------------------

# --- BACKEND SERVER CONFIGURATION ---
# Sunucunun çalışacağı port (Hizmet sağlayıcılar otomatik atar, yoksa 3000 olur)
PORT=3000

# Canlı MongoDB kümesi bağlantı adresi (Örn: MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kelime_patlat?retryWrites=true&w=majority

# Web istemcisinin (frontend) canlı adresi (OAuth yönlendirmeleri için)
EXPO_WEB_PREVIEW_URL=https://kelime-patlat.app


# --- FRONTEND CLIENT CONFIGURATION (React Native / Expo) ---
# Expo uygulamasının canlı backend sunucusuna bağlanması için URL adresi
EXPO_PUBLIC_API_BASE_URL=https://api.kelime-patlat.app
