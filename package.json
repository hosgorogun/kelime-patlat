{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "npx expo start",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:all": "node scripts/dev.js",
    "dev:metro": "npx expo start --web --port 8082",
    "android": "npx expo start --android",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:mongo": "cross-env RUN_MONGODB_INTEGRATION=true vitest run tests/mongodb-connection.test.ts",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "^57.0.7",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "express": "^5.1.0",
    "jose": "6.1.0",
    "mongoose": "^9.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
